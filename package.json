{
    "name": "ai-clash",
    "description": "AI Clash / AI 对撞机：一次提问，多款网页 AI 同屏对比；支持中英文界面，内置 AI 裁判总结共识、分歧和最优答案。",
    "license": "GPL-3.0-or-later",
    "private": true,
    "version": "1.2.2",
    "type": "module",
    "workspaces": [
        "packages/inject",
        "packages/site"
    ],
    "scripts": {
        "dev": "bun run build:inject && vite --host localhost --port 5174",
        "dev:checked": "bun run build:inject && tsc --noEmit && vite --host localhost --port 5174",
        "dev:watch-build": "bun run build:inject && vite build --watch",
        "dev:site": "cd packages/site && bun dev",
        "dev:api": "cd packages/api && mvn spring-boot:run",
        "build:site": "cd packages/site && bun run build",
        "typecheck": "tsc --noEmit && (cd packages/inject && bun run typecheck)",
        "build:inject": "bun --filter @ai-clash/inject build",
        "build:api": "docker build -f packages/api/Dockerfile -t ai-clash-api:local .",
        "build": "bun run build:inject && tsc --noEmit && vite build",
        "build:test": "bun run build:inject && tsc --noEmit && vite build && bun run test",
        "test": "playwright test",
        "test:ui": "playwright test --ui"
    },
    "dependencies": {
        "@ant-design/icons": "^6.2.5",
        "@ant-design/x": "^2.8.0",
        "@ant-design/x-markdown": "^2.8.0",
        "@ant-design/x-sdk": "^2.8.0",
        "@lobehub/icons": "^5.10.0",
        "antd": "^6.4.4",
        "antd-style": "^4.1.0",
        "dayjs": "^1.11.21",
        "motion": "^12.40.0",
        "openai": "^6.42.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-markdown": "^10.1.0",
        "zustand": "^5.0.14"
    },
    "sideEffects": false,
    "devDependencies": {
        "@crxjs/vite-plugin": "^2.6.1",
        "@playwright/test": "^1.60.0",
        "@types/chrome": "^0.1.43",
        "@types/node": "^24.13.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react-swc": "^4.3.1",
        "cross-env": "^10.1.0",
        "typescript": "~5.9.3",
        "vite": "^7.3.5",
        "vite-plugin-compression": "^0.5.1",
        "vite-plugin-zip-pack": "^1.2.4"
    }
}
