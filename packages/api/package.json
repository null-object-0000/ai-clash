{
  "name": "@ai-clash/api",
  "version": "0.1.0",
  "private": true,
  "description": "AI Clash backend API service",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "bun --watch src/index.ts",
    "dev:build": "tsc -p tsconfig.json --watch",
    "migrate": "node dist/migrate.js",
    "migrate:local": "bun src/migrate.ts"
  },
  "dependencies": {
    "mysql2": "^3.22.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "typescript": "~5.9.3"
  }
}
